{
  "monitored_folders": [],
  "active_folder_id": "",
  "monitored_folder": "",
  "welcome_shown": false,
  "rules": [
    {
      "id": "ignore_temp_files",
      "name": "忽略临时文件",
      "type": "extension",
      "extensions": [
        ".tmp",
        ".part",
        ".crdownload"
      ],
      "target": "",
      "enabled": true,
      "priority": 10,
      "action": "ignore"
    },
    {
      "id": "images",
      "name": "图片",
      "type": "extension",
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp"
      ],
      "target": "图片",
      "enabled": true,
      "priority": 20,
      "action": "move"
    },
    {
      "id": "pdf_documents",
      "name": "PDF 文档",
      "type": "extension",
      "extensions": [
        ".pdf"
      ],
      "target": "PDF文档",
      "enabled": true,
      "priority": 30,
      "action": "move"
    }
  ],
  "settings": {
    "auto_start_organizing": false,
    "scan_existing_on_start": true,
    "manual_duplicate_policy": "ask",
    "auto_duplicate_policy": "keep_both",
    "recent_activity_limit": 50,
    "close_behavior": "exit",
    "launch_at_login": false,
    "notifications_enabled": true
  }
}
