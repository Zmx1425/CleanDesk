{
  "monitored_folders": [],
  "active_folder_id": "",
  "monitored_folder": "",
  "welcome_shown": false,
  "rules": [
    {
      "id": "name_invoice",
      "name": "发票文件",
      "type": "name_contains",
      "keywords": ["发票", "invoice"],
      "target": "发票",
      "enabled": true,
      "priority": 10,
      "action": "move"
    },
    {
      "id": "name_course",
      "name": "课程资料",
      "type": "name_contains",
      "keywords": ["课程"],
      "target": "课程资料",
      "enabled": true,
      "priority": 20,
      "action": "move"
    },
    {
      "id": "images",
      "name": "图片",
      "type": "extension",
      "extensions": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".tiff", ".heic", ".svg"],
      "target": "图片",
      "enabled": true,
      "priority": 30,
      "action": "move"
    },
    {
      "id": "pdf",
      "name": "PDF 文档",
      "type": "extension",
      "extensions": [".pdf"],
      "target": "PDF文档",
      "enabled": true,
      "priority": 40,
      "action": "move"
    },
    {
      "id": "videos",
      "name": "视频",
      "type": "extension",
      "extensions": [".mp4", ".mov", ".avi", ".mkv", ".wmv", ".flv", ".webm", ".m4v"],
      "target": "视频",
      "enabled": true,
      "priority": 50,
      "action": "move"
    },
    {
      "id": "music",
      "name": "音频",
      "type": "extension",
      "extensions": [".mp3", ".wav", ".aac", ".flac", ".m4a", ".ogg", ".wma"],
      "target": "音频",
      "enabled": true,
      "priority": 60,
      "action": "move"
    }
  ],
  "settings": {
    "auto_start_organizing": false,
    "scan_existing_on_start": true,
    "manual_duplicate_policy": "ask",
    "auto_duplicate_policy": "keep_both",
    "recent_activity_limit": 50,
    "close_behavior": "exit",
    "launch_at_login": false
  }
}
